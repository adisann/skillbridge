# ==============================================================================
# SkillBridge Environment Configuration Template (.env.example)
# Salin berkas ini ke .env.local untuk Next.js (web/) dan .env untuk Worker (worker/)
# JANGAN PERNAH MENYIMPAN KUNCI RAHASIA ASLI DI REPOSITORI GIT
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database & Authentication)
# ------------------------------------------------------------------------------
# URL project Supabase Anda (bisa dilihat di Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci anonim publik (Aman digunakan di browser Next.js)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Kunci Service Role (HANYA UNTUK WORKER & SERVER-SIDE, JANGAN DIEKSPOS KE CLIENT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# ------------------------------------------------------------------------------
# 2. Cloudflare R2 (Penyimpanan Dokumen CV Privat)
# ------------------------------------------------------------------------------
# ID Akun Cloudflare
R2_ACCOUNT_ID=your-cloudflare-account-id

# Kredensial API S3-compatible R2
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Nama bucket penyimpanan CV (Privat)
R2_BUCKET_NAME=skillbridge-resumes

# Endpoint S3 privat dibentuk dari R2_ACCOUNT_ID; akses berkas memakai presigned URL.

# ------------------------------------------------------------------------------
# 3. Penyedia AI & Model Embedding (Ekstraksi CV & Pencocokan Semantik)
# ------------------------------------------------------------------------------
# Provider yang didukung: gemini | openai | anthropic
AI_PROVIDER=gemini
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768


# ------------------------------------------------------------------------------
# 5. Konfigurasi Worker & Scraping
# ------------------------------------------------------------------------------
WORKER_MAX_LIMIT=25
HTTP_TIMEOUT=15
WORKER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

